# Release line for this branch; see RELEASING.md.
# Each DuckDB line has its own branch, extension version series, and pins.
RELEASE_BRANCH=v1.x
SERIES=0.1
DUCKDB_VERSION=v1.5.6
DUCKDB_COMMIT=069cc9f9b5be802405797faecc284961b07c70ef
CI_TOOLS_VERSION=v1.5-variegata
# Platforms never built or released (DuckDB's names, ';'-separated).
EXCLUDED_PLATFORMS="osx_amd64;wasm_mvp;wasm_eh;wasm_threads"
# Whether releases from this line become the repository's "latest" release.
LATEST=false
